APP_NAME="UAC Présences"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://presence-uac-backend.onrender.com

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
# Heure locale des cours. Ne pas repasser en UTC sans annuler d'abord la
# migration horodatages_a_l_heure_du_benin.
APP_TIMEZONE=Africa/Porto-Novo

LOG_CHANNEL=stderr
LOG_LEVEL=error

# ─────────────────────────────────────────────────────────────────────────────
# BASE DE DONNÉES
#
# ⚠️ Ne jamais faire pointer ce fichier sur la base de PRODUCTION. Une commande
# lancée sans y penser (migrate, db:seed, migrate:fresh) s'appliquerait aux
# données réelles de l'université. Les identifiants de production n'ont leur
# place que dans le tableau de bord de l'hébergeur.
#
# Base de développement locale, par exemple avec Docker :
#   docker run -d --name uac-pg -e POSTGRES_PASSWORD=postgres \
#     -e POSTGRES_DB=presence_uac_dev -p 55433:5432 postgres:18-alpine
#   php artisan migrate
#   php artisan db:seed --class=AnneeAcademiqueSeeder
#   php artisan db:seed --class=FiliereSeeder
#   php artisan db:seed --class=FiliereAnneeSeeder
# ─────────────────────────────────────────────────────────────────────────────
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=55433
DB_DATABASE=presence_uac_dev
DB_USERNAME=postgres
DB_PASSWORD=postgres
# « disable » en local : un serveur Postgres local ne propose pas SSL. En
# production, l'hébergeur managé exige « require ».
DB_SSLMODE=disable

# DB_URL prime sur DB_HOST lorsqu'elle est renseignée — à laisser vide en
# développement, sous peine de contourner la configuration locale ci-dessus.
# DB_URL=

# Supabase Storage (S3 compatible)
SUPABASE_URL=https://VOTRE_PROJET.supabase.co
SUPABASE_KEY=VOTRE_CLE_S3_SUPABASE
SUPABASE_SECRET=VOTRE_SECRET_S3_SUPABASE
SUPABASE_BUCKET=presence-uac
FILESYSTEM_DISK=supabase

# CORS — URL du frontend Vercel
ALLOWED_ORIGINS=https://presence-uac.vercel.app

# FRONTEND_URL est l'URL encodee DANS le QR Code (QrCodeImageService).
# En developpement local, la laisser sur Vercel fait pointer les QR generes vers
# la production : le code s'affiche, se scanne, et emmene l'etudiant sur une
# autre base de donnees. Pour tester les QR en local :
#   FRONTEND_URL=http://localhost:5173
FRONTEND_URL=https://presence-uac.vercel.app

# File d'attente et cache. Pas de Redis ni de worker permanent (le plan gratuit
# de Render n'en offre pas) : le planificateur draine la file chaque minute
# (routes/console.php). Les identifiants envoyés aux étudiants et les analyses
# IA passent par cette file.
QUEUE_CONNECTION=database
# « file » et non « database » pour le cache : le limiteur de débit le lit et
# l'écrit à chaque requête, et la base est à ~600 ms d'aller-retour. Sans cette
# ligne, Laravel retombe sur « redis », qui n'existe pas ici.
CACHE_STORE=file

# Cookie de session : « Secure » derrière HTTPS. L'API authentifie par jeton
# Bearer, la session ne sert qu'à la connexion web ; à laisser vide en local
# (http), sous peine de ne plus recevoir le cookie.
# SESSION_SECURE_COOKIE=true

# Mail. Le SMTP sortant est bloqué sur Render : en production, l'API HTTP Resend.
MAIL_MAILER=log
# RESEND_KEY=
MAIL_FROM_ADDRESS="noreply@presence.uac.bj"
MAIL_FROM_NAME="${APP_NAME}"

# ─────────────────────────────────────────────────────────────────────────────
# IA — extraction des maquettes et des emplois du temps (config/ai.php)
#
# Le nom du modèle n'est JAMAIS dans le code : Google a retiré gemini-2.0-flash
# du jour au lendemain et toute analyse a échoué sans qu'un test le voie.
# Fournisseurs : gemini | groq | openrouter. Groq exige pdftotext (poppler-utils)
# et ne lit que du texte : un PDF scanné veut gemini.
# ─────────────────────────────────────────────────────────────────────────────
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# Secondes, puis relances sur 429 / 5xx / timeout (le délai double à chaque fois).
# Gemini reçoit le PDF entier : budget plus large que les deux autres.
GEMINI_TIMEOUT=180
GEMINI_MAX_RETRIES=3

# GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile
# GROQ_TIMEOUT=120
# GROQ_MAX_RETRIES=2
# GROQ_MAX_TOKENS=4096
# GROQ_TEMPERATURE=0.1

# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=google/gemini-2.5-flash
# OPENROUTER_TIMEOUT=120
# OPENROUTER_MAX_RETRIES=2
# OPENROUTER_MAX_TOKENS=4096
# OPENROUTER_TEMPERATURE=0.1

# Comptes d'administration initiaux (AdminUserSeeder).
# Si vides, un mot de passe aléatoire est généré et le compte doit être
# réinitialisé via « mot de passe oublié ». Ne jamais committer de vraie valeur.
SEED_SUPERADMIN_PASSWORD=
SEED_ADMIN_PASSWORD=

# Fenêtre de prise de présence (voir config/presence.php).
# Bornes exprimées en minutes autour de l'HEURE DE FIN du cours.
PRESENCE_SCAN_AVANT_FIN=15
PRESENCE_SCAN_APRES_FIN=10

# Durée de vie d'un token QR avant rotation, en secondes. Le planificateur
# tournant chaque minute, une valeur nettement inférieure à 60 reste théorique.
PRESENCE_QR_TTL=60

# Combien de minutes avant la fin du cours l'étudiant responsable (délégué) voit
# le QR Code dans l'application mobile. La fenêtre de scan ouvre, elle, quinze
# minutes avant la fin : à 15, les deux s'alignent.
PRESENCE_QR_DELEGUE_AVANT_FIN=10

# Plafond de durée d'UN créneau, en heures. Distinct du volume horaire de l'EC,
# qui borne le total des séances.
PRESENCE_SEANCE_DUREE_MAX=5

# Limites de débit du scan, par minute. Par étudiant : la règle (3). Par IP : un
# plafond large — une salle ou un campus partagent une même adresse, il doit
# rester très au-dessus de 500 (hypothèse H3). Voir config/presence.php.
PRESENCE_SCAN_MAX_PAR_ETUDIANT=3
PRESENCE_SCAN_MAX_PAR_IP=2000
