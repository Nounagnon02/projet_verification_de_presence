APP_NAME="Présence UAC"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://presence-uac-backend.onrender.com

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr

LOG_CHANNEL=stderr
LOG_LEVEL=error

# ─────────────────────────────────────────────────────────────────────────────
# BASE DE DONNÉES
#
# ⚠️ Ne jamais faire pointer ce fichier sur la base de PRODUCTION. Une commande
# lancée sans y penser (migrate, db:seed, migrate:fresh) s'appliquerait aux
# données réelles de l'université. Les identifiants de production n'ont leur
# place que dans le tableau de bord de l'hébergeur.
#
# Base de développement locale, par exemple avec Docker :
#   docker run -d --name uac-pg -e POSTGRES_PASSWORD=postgres \
#     -e POSTGRES_DB=presence_uac_dev -p 55433:5432 postgres:18-alpine
#   php artisan migrate
#   php artisan db:seed --class=AnneeAcademiqueSeeder
#   php artisan db:seed --class=FiliereSeeder
#   php artisan db:seed --class=FiliereAnneeSeeder
# ─────────────────────────────────────────────────────────────────────────────
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=55433
DB_DATABASE=presence_uac_dev
DB_USERNAME=postgres
DB_PASSWORD=postgres
# « disable » en local : un serveur Postgres local ne propose pas SSL. En
# production, l'hébergeur managé exige « require ».
DB_SSLMODE=disable

# DB_URL prime sur DB_HOST lorsqu'elle est renseignée — à laisser vide en
# développement, sous peine de contourner la configuration locale ci-dessus.
# DB_URL=

# Supabase Storage (S3 compatible)
SUPABASE_URL=https://VOTRE_PROJET.supabase.co
SUPABASE_KEY=VOTRE_CLE_S3_SUPABASE
SUPABASE_SECRET=VOTRE_SECRET_S3_SUPABASE
SUPABASE_BUCKET=presence-uac
FILESYSTEM_DISK=supabase

# CORS — URL du frontend Vercel
ALLOWED_ORIGINS=https://presence-uac.vercel.app
FRONTEND_URL=https://presence-uac.vercel.app

# Mail
MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@presence.uac.bj"
MAIL_FROM_NAME="${APP_NAME}"

# Google Gemini IA
GEMINI_API_KEY=

# Comptes d'administration initiaux (AdminUserSeeder).
# Si vides, un mot de passe aléatoire est généré et le compte doit être
# réinitialisé via « mot de passe oublié ». Ne jamais committer de vraie valeur.
SEED_SUPERADMIN_PASSWORD=
SEED_ADMIN_PASSWORD=

# Fenêtre de prise de présence (voir config/presence.php).
# Bornes exprimées en minutes autour de l'HEURE DE FIN du cours.
PRESENCE_SCAN_AVANT_FIN=15
PRESENCE_SCAN_APRES_FIN=10

# Durée de vie d'un token QR avant rotation, en secondes. Le planificateur
# tournant chaque minute, une valeur nettement inférieure à 60 reste théorique.
PRESENCE_QR_TTL=60
