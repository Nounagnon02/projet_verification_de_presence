# ============================================================
# Base de données de TEST
#
# Copier ce fichier en `.env.testing` : Laravel le charge
# automatiquement quand APP_ENV=testing (défini dans phpunit.xml).
#
# Sans ce fichier, la suite refuse de démarrer pour ne pas
# s'exécuter sur la base applicative (voir tests/TestCase.php).
# ============================================================

APP_ENV=testing
APP_KEY=base64:0000000000000000000000000000000000000000000=

# ── Option A : SQLite en mémoire (rapide, aucune infrastructure) ──
# Nécessite l'extension pdo_sqlite :
#   sudo apt install php8.3-sqlite3
# Attention : trois migrations utilisent du SQL spécifique à Postgres
# (fix_database_schema, fix_tokenable_id_for_uuids,
# fix_presences_statut_check_constraint) et échoueront sur SQLite.
# DB_CONNECTION=sqlite
# DB_DATABASE=:memory:

# ── Option B : base Postgres dédiée (fidèle à la production) ──
# Le plus simple est le conteneur jetable que pilote le Makefile :
#   make db-up        (PostgreSQL 15 sur 127.0.0.1:55434)
# Le port 55434 plutôt que 5432 pour ne pas entrer en conflit avec un
# PostgreSQL déjà installé sur la machine, et surtout pour qu'une erreur de
# configuration ne fasse jamais tomber la suite sur la base de développement.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=55434
DB_DATABASE=presence_uac_test
DB_USERNAME=postgres
DB_PASSWORD=postgres

# Ne jamais envoyer d'email réel depuis les tests
MAIL_MAILER=array
QUEUE_CONNECTION=sync
CACHE_STORE=array
SESSION_DRIVER=array

# Stockage local. Le disque « supabase » construit son endpoint S3 à partir de
# SUPABASE_URL : absente ici, l'endpoint devient « /storage/v1/s3 », que le SDK
# AWS rejette comme URI invalide.
FILESYSTEM_DISK=local

# Pour une base Postgres locale : la configuration exige SSL par défaut (utile
# pour l'hébergeur managé), ce qu'un serveur local ne propose pas.
DB_SSLMODE=disable
