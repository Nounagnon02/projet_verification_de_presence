# ============================================================
# Base de données de TEST
#
# Copier ce fichier en `.env.testing` : Laravel le charge
# automatiquement quand APP_ENV=testing (défini dans phpunit.xml).
#
# Sans ce fichier, la suite refuse de démarrer pour ne pas
# s'exécuter sur la base applicative (voir tests/TestCase.php).
# ============================================================

APP_ENV=testing
APP_KEY=base64:0000000000000000000000000000000000000000000=

# ── Option A : SQLite en mémoire (rapide, aucune infrastructure) ──
# Nécessite l'extension pdo_sqlite :
#   sudo apt install php8.3-sqlite3
# Attention : trois migrations utilisent du SQL spécifique à Postgres
# (fix_database_schema, fix_tokenable_id_for_uuids,
# fix_presences_statut_check_constraint) et échoueront sur SQLite.
# DB_CONNECTION=sqlite
# DB_DATABASE=:memory:

# ── Option B : base Postgres dédiée (fidèle à la production) ──
# Créer un second projet Supabase gratuit, ou une base locale :
#   createdb presence_uac_test
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=presence_uac_test
DB_USERNAME=postgres
DB_PASSWORD=postgres

# Ne jamais envoyer d'email réel depuis les tests
MAIL_MAILER=array
QUEUE_CONNECTION=sync
CACHE_STORE=array
SESSION_DRIVER=array
